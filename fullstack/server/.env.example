# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Leave empty for local testing: a temporary in-memory database is used instead.
MONGODB_URI=

# Long random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port for the API (Render sets this automatically).
PORT=5000

# Only needed if the React site is hosted on a different domain from the API,
# e.g. https://ramchandrappa.github.io  (comma-separate several origins).
CORS_ORIGIN=
